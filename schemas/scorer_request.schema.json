{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prman.dev/schemas/scorer_request.schema.json",
  "title": "PRman scorer request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "context", "criteria"],
  "properties": {
    "schema_version": {"const": "prman-scorer-request/1.1"},
    "candidate_id": {"$ref": "#/$defs/sha256"},
    "context": {"$ref": "#/$defs/context"},
    "criteria": {
      "const": [
        "correctness",
        "task_alignment",
        "scope",
        "repository_conventions",
        "maintainability",
        "reviewer_effort"
      ]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "code", "source", "summary", "log_digest"],
      "properties": {
        "gate": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "code": {"type": "string", "minLength": 1},
        "source": {"enum": ["command", "inspection", "service"]},
        "summary": {"type": "string", "minLength": 1},
        "log_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "base_commit",
        "task",
        "task_digest",
        "repository_rules",
        "diff",
        "evidence"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/sha256"},
        "base_commit": {"$ref": "#/$defs/revision"},
        "task": {"type": "string", "minLength": 1},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "repository_rules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "diff": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      }
    }
  }
}
