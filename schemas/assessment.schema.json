{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prman.dev/schemas/assessment.schema.json",
  "title": "PRman assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "context", "attestation", "candidates"],
  "properties": {
    "schema_version": {"const": "prman-assessment/1.1"},
    "mode": {"enum": ["single", "compare"]},
    "context": {"$ref": "#/$defs/context"},
    "attestation": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/attestation"}
      ]
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "single"}}},
      "then": {"properties": {"candidates": {"minItems": 1, "maxItems": 1}}},
      "else": {"properties": {"candidates": {"minItems": 2}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "key_id", "signature"],
      "properties": {
        "scheme": {"const": "hmac-sha256"},
        "key_id": {"type": "string", "minLength": 1},
        "signature": {"$ref": "#/$defs/sha256"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "base_commit",
        "task",
        "task_digest",
        "repository_rules"
      ],
      "properties": {
        "repository_id": {"$ref": "#/$defs/sha256"},
        "base_commit": {"$ref": "#/$defs/revision"},
        "task": {"type": "string", "minLength": 1},
        "task_digest": {"$ref": "#/$defs/sha256"},
        "repository_rules": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "diff", "truncation_ratio", "gates"],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/sha256"},
        "diff": {"type": "string", "minLength": 1},
        "truncation_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "gates": {
          "type": "array",
          "items": {"$ref": "#/$defs/gate"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "candidate_id",
        "observed_at",
        "producer",
        "producer_version",
        "summary",
        "log_digest",
        "command",
        "exit_code"
      ],
      "properties": {
        "source": {"enum": ["command", "inspection", "service"]},
        "candidate_id": {"$ref": "#/$defs/sha256"},
        "observed_at": {"type": "string", "format": "date-time"},
        "producer": {"type": "string", "minLength": 1},
        "producer_version": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "log_digest": {"$ref": "#/$defs/sha256"},
        "command": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          ]
        },
        "exit_code": {"type": ["integer", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"source": {"const": "command"}}},
          "then": {
            "properties": {
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              },
              "exit_code": {"type": "integer"}
            }
          },
          "else": {
            "properties": {
              "command": {"type": "null"},
              "exit_code": {"type": "null"}
            }
          }
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "recoverable", "code", "evidence", "actionable"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "unknown"]},
        "recoverable": {"type": "boolean"},
        "code": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "actionable": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pass"}}},
          "then": {"properties": {"recoverable": {"const": false}}}
        },
        {
          "if": {"properties": {"recoverable": {"const": true}}},
          "then": {
            "properties": {
              "status": {"const": "fail"},
              "actionable": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "name": {"const": "tests"},
              "status": {"const": "pass"}
            },
            "required": ["name", "status"]
          },
          "then": {
            "properties": {
              "evidence": {
                "properties": {
                  "source": {"const": "command"},
                  "exit_code": {"const": 0}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {"const": "pass"},
              "evidence": {"properties": {"source": {"const": "command"}}}
            },
            "required": ["status", "evidence"]
          },
          "then": {
            "properties": {"evidence": {"properties": {"exit_code": {"const": 0}}}}
          }
        }
      ]
    }
  }
}
